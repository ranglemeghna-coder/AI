'f': {}
}

h = {'a':4,'b':3,'c':2,'d':3,'e':2,'f':0}
def greedy(s,g):
    path=[s]
    while s !=g:
        if not graph[s]:return[]
        mn=99
        for n in graph[s]:
            if h[n]< mn:
                mn=h[n]
                next=n
            s=next
            path.append(s)
        return path
