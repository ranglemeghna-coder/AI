from collections import deque
def bfs(graph,start):
    seen=set([start])
    queue=deque([start])

    while queue:
        node=queue.popleft()
        print(node,end="")
        for n in graph[node]:
            if n not in seen:
                seen.add(n)
                queue.append(n)
